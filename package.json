{
  "name": "@pi-vault/pi-status",
  "version": "0.6.1",
  "type": "module",
  "description": "Pi extension that replaces the default status with a Codex-like status",
  "author": "Lanh Hoang <lanhhoang@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/pi-vault/pi-status#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-vault/pi-status.git"
  },
  "bugs": {
    "url": "https://github.com/pi-vault/pi-status/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-status"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry-run": "pnpm pack --dry-run",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "release:check": "pnpm check && pnpm run pack:dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "src",
    "docs/assets",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "dependencies": {
    "@pi-vault/pi-usage": "^0.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
